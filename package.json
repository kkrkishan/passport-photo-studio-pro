{
  "name": "passport-photo-studio-pro",
  "productName": "Passport Photo Studio Pro",
  "version": "1.0.0",
  "description": "Professional Passport Photo Editor, Document Scanner and Print Sheet Maker for Windows",
  "author": "Antigravity Software",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:appx": "npm run build && electron-builder --win appx",
    "package:android": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleRelease bundleRelease && cd .."
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.passportphoto.studiopro",
    "productName": "Passport Photo Studio Pro",
    "copyright": "Copyright © 2026 Passport Photo Studio Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "PassportPhotoStudioPro-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Passport Photo Studio Pro",
      "uninstallDisplayName": "Passport Photo Studio Pro"
    },
    "appx": {
      "applicationId": "PassportPhotoStudio",
      "identityName": "kkrkishan.PassportPhotoStudio",
      "displayName": "Passport Photo Studio",
      "publisherDisplayName": "kkrkishan",
      "publisher": "CN=7AB9EB13-5C49-4A1C-95D7-56862452C8DF",
      "showNameOnTiles": true,
      "artifactName": "PassportPhotoStudio-Store.${ext}",
      "languages": [
        "en-US",
        "hi-IN"
      ]
    }
  }
}
